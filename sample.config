# BPB Auto-Setup — Sample Configuration
# Copy to config.local.js or set via environment if needed.
# DO NOT commit real secrets.

{
  "emailProvider": "manual",
  "emailDomain": "example.com",
  "browserHeadless": false,
  "browserSlowMo": 0,
  "logLevel": "info",
  "telemetryEnabled": false,
  "autoCheckUpdates": true,
  "dataDirectory": "$APPDATA/bpb-auto-setup"
}

# Security notes:
- API tokens should only be stored via the app's credential store (keytar).
- Never put tokens or passwords in this file if using version control.
- Use .gitignore to exclude local database and credential caches.
